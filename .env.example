# API
PORT=3000
NODE_ENV=development

# PostgreSQL (principal)
DATABASE_URL=postgresql://username:password@localhost:5432/stylecut_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stylecut_db
DB_USER=username
DB_PASSWORD=password

# SQLite (fallback)
SQLITE_FILENAME=./database/stylecut.sqlite

# Frontend (Vite)
VITE_API_URL=http://localhost:3000
VITE_API_BASE_PATH=/api
VITE_DEV_SERVER_PORT=5173
VITE_PROXY_TARGET=http://localhost:3000

# Docker Compose (valores padrão)
POSTGRES_DB=stylecut_db
POSTGRES_USER=stylecut
POSTGRES_PASSWORD=stylecutpwd
# DATABASE_URL do backend apontando para o serviço do Compose
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
