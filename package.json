{
  "name": "stylecut-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node server/index.js",
    "server": "nodemon server/index.js",
    "migrate": "node server/db/runMigrations.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:backend": "cross-env NODE_ENV=test SQLITE_FILENAME=:memory: jest --runInBand",
    "test:backend:watch": "cross-env NODE_ENV=test SQLITE_FILENAME=:memory: jest --watch",
    "test:frontend": "vitest run",
    "test:frontend:watch": "vitest",
    "test": "npm run test:backend && npm run test:frontend"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.51.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "knex": "^3.1.0",
    "pg": "^8.11.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "sqlite3": "^5.1.7",
    "uuid": "^9.0.1",
    "react-hook-form": "^7.53.0",
    "zod": "^3.23.8",
    "@hookform/resolvers": "^3.9.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "jsdom": "^24.1.0",
    "nodemon": "^3.0.3",
    "postcss": "^8.4.41",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.9",
    "typescript": "^5.5.4",
    "vite": "^5.4.1",
    "vitest": "^2.0.5"
  }
}
